{
  "cli": {
    "version": ">= 16.24.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "credentialsSource": "local"
      },
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development-simulator"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "release-ios": {
      "extends": "production",
      "environment": "production",
      "autoIncrement": false
    },
    "release-play": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "release-android": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762112437",
        "appleTeamId": "BDV35GTHAU"
      }
    }
  }
}
