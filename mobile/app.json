{
  "expo": {
    "name": "Repeat AI",
    "slug": "seller-signal",
    "owner": "lateefsan-2",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cae8513-9326-42eb-8cdb-3b07f6785b71"
    },
    "scheme": "seller-signal",
    "orientation": "portrait",
    "icon": "./assets/repeat-ai-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.lateefsan.sellersignal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "buildNumber": "35"
    },
    "android": {
      "package": "com.lateefsan.sellersignal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/repeat-ai-adaptive-foreground.png",
        "backgroundColor": "#000000"
      },
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/repeat-ai-icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Repeat AI to choose your profile photo.",
          "cameraPermission": "Allow Repeat AI to take your profile photo."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow Repeat AI to use your microphone for voice conversations."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/repeat-ai-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4cae8513-9326-42eb-8cdb-3b07f6785b71"
      }
    }
  }
}
