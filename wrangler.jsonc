{
  "name": "repeat-ai",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "repeatai.org/*", "zone_name": "repeatai.org" },
    { "pattern": "www.repeatai.org/*", "zone_name": "repeatai.org" }
  ],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "observability": { "enabled": true }
}
