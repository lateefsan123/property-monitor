{
  "manifest_version": 3,
  "name": "Repeat AI • Table to spreadsheets",
  "version": "0.1.0",
  "description": "Collect a web table, choose buildings, and download separate Excel files for Repeat AI.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "Export sellers to spreadsheets" },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
