{
  "manifest_version": 3,
  "name": "Repeat AI • Table to spreadsheets",
  "version": "0.1.2",
  "description": "Collect a web table, choose buildings, and download separate Excel files for Repeat AI.",
  "icons": { "16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png" },
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting"],
  "action": { "default_title": "Export sellers to spreadsheets", "default_icon": { "16": "icon-16.png", "32": "icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
