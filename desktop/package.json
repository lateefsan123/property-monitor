{
  "name": "@repeat-ai/desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Repeat AI desktop app.",
  "author": "Repeat AI",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/lateefsan123/property-monitor.git"
  },
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test \"tests/*.test.cjs\"",
    "package:win": "npm test && electron-builder --win nsis && npm run smoke:win-package",
    "publish:win": "npm run package:win && electron-builder --win nsis --publish always --prepackaged release/win-unpacked",
    "smoke:win-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-windows-package.ps1"
  },
  "build": {
    "appId": "ai.repeat.desktop",
    "productName": "Repeat AI",
    "asar": true,
    "afterPack": "build/after-pack.cjs",
    "files": [
      "main.cjs",
      "url-policy.cjs",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public/logo.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lateefsan123",
        "repo": "property-monitor"
      }
    ],
    "win": {
      "icon": "../public/logo.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Repeat-AI-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Repeat AI"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  }
}
